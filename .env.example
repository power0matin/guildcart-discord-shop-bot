# GuildCart - local development configuration
# Copy to .env and replace placeholders. Never commit .env.
# These variables support the current prototype; the config schema will evolve.

# Discord bot token (required)
DISCORD_TOKEN=replace_with_your_discord_bot_token

# Ticket and admin configuration
CATEGORY_NAME=tickets
ADMIN_CHANNEL_NAME=admin-notify
ADMIN_ROLE_NAME=Admin
TICKET_NAME_TEMPLATE=ticket-{author}-{rand6}

# Local SQLite database for durable order records, not proof of payment.
# Keep backups private and restrict filesystem access.
PAYMENT_TIMEOUT_MINUTES=30
PAYMENTS_DB=data/payments.db

# Payment instructions for the legacy prototype. Configure privately.
CARD_NUMBER=Configure payment instructions privately
CRYPTO_ADDRESS_USDT=

# Shop branding (generic defaults; customize per deployment)
SHOP_TITLE=GuildCart | Digital Shop
SHOP_DESCRIPTION=Choose a product to start an order.
SHOP_FOOTER=Your order will be reviewed by the shop team.
TELEGRAM_SHOP_URL=
TELEGRAM_SUPPORT_URL=

# Button labels
BTN_SHOP_LABEL=Shop channel
BTN_SUPPORT_LABEL=Support
BTN_PAY_LABEL=Submit payment details
BTN_CLOSE_LABEL=Close ticket
